# ReNile remote MCP server configuration.
# Copy to src/.env for local development:  cp .env.example src/.env
# In a container, set these as real environment variables instead -- they take
# precedence over the file.

# --- OAuth (required) --------------------------------------------------------
# The ReNile authorization server that issues access tokens. No trailing slash:
# RFC 8414 compares issuers by exact string.
RENILE_ISSUER_URL=https://auth.renile-iot.com

# The exact public URL clients connect to, including the /mcp path. The 401
# challenge and the protected-resource metadata route are both derived from it,
# so a mismatch here breaks OAuth discovery with no useful error.
RENILE_RESOURCE_SERVER_URL=https://mcp.renile-iot.com/mcp

# --- HTTP server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Must include the public hostname or every proxied request is rejected with 421.
ALLOWED_HOSTS=mcp.renile-iot.com
ALLOWED_ORIGINS=
# Sessions live in a per-process dict. Leave false unless you run several
# replicas without sticky routing.
STATELESS_HTTP=false

# --- Upstream ReNile API -----------------------------------------------------
# The caller's own access token is forwarded upstream with this scheme. The
# platform has historically used `JWT`, not `Bearer`.
RENILE_UPSTREAM_AUTH_SCHEME=JWT
RENILE_API_BASE_URL=https://renile-iot.com
RENILE_DEVICES_PATH=/api/v1/devices/names/
RENILE_SNAPSHOT_PATH=/api/v1/snapshot/

# --- HTTP client -------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15.0
# Total attempts per request; 1 disables retrying. Timeouts are never retried.
HTTP_MAX_ATTEMPTS=2
# The pool is shared by every user of the server.
HTTP_MAX_CONNECTIONS=100
# How much of an upstream error body to quote back in a tool error.
ERROR_BODY_PREVIEW_CHARS=200

# --- Behaviour ---------------------------------------------------------------
LOG_LEVEL=INFO
# A reading older than this many seconds is flagged is_stale.
STALE_AFTER_SECONDS=3600

# --- Stage gate ---------------------------------------------------------------
# false (stage 1): /mcp answers a bare 401, no WWW-Authenticate, no .well-known
# route, so a client cannot begin OAuth discovery.
# true  (stage 2): full resource-server wiring. RENILE_ISSUER_URL and
# RENILE_RESOURCE_SERVER_URL are only consumed when this is true.
OAUTH_CHALLENGE_ENABLED=false
